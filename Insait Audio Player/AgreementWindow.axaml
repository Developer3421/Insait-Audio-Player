<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Insait_Audio_Player.AgreementWindow"
        Icon="avares://Insait Audio Player/Modern_futuristic_audio_player (2).ico"
        Width="560"
        Height="420"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        Title="User Agreement">
    <Window.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#20FFDAB0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#CCE53935"/>
        </Style>
    </Window.Styles>

    <Border Background="#FF1F1A24"
            BorderBrush="#FF7C3AED"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid RowDefinitions="38,*">
            <Border Name="TitleBar"
                    Grid.Row="0"
                    Background="#FF2D2438">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Name="AgreementWindowTitleBarText"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#FFF0E8F4"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                    <Border Grid.Column="1" Background="Transparent"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Name="MinimizeButton" Classes="window-control">
                            <Border Width="20" Height="20" CornerRadius="4" ClipToBounds="True">
                                <Image Source="avares://Insait Audio Player/Icons/MinButton.png"
                                       Width="16"
                                       Height="16"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </Button>
                        <Button Name="CloseButton" Classes="window-control close">
                            <Border Width="20" Height="20" CornerRadius="4" ClipToBounds="True">
                                <Image Source="avares://Insait Audio Player/Icons/CloseButton.png"
                                       Width="16"
                                       Height="16"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="20" Background="#FF1F1A24">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Name="AgreementTitleText"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#FFF0E8F4"/>
                        <TextBlock Name="AgreementSubtitleText"
                                   FontSize="12"
                                   Foreground="#FFDCC4FF"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#FF2A2230"
                            CornerRadius="12"
                            Padding="16"
                            BorderBrush="#FF3E3050"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Name="AgreementBodyText"
                                       TextWrapping="Wrap"
                                       Foreground="#FFF0E8F4"
                                       LineHeight="20"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Name="AgreementFooterText"
                                   VerticalAlignment="Center"
                                   Foreground="#FF9E90B0"
                                   TextWrapping="Wrap"/>
                        <Button Grid.Column="1"
                                Name="DeclineButton"
                                MinWidth="110"
                                Background="#FF3E3050"
                                Foreground="#FFF0E8F4">
                            <TextBlock Name="DeclineButtonText"/>
                        </Button>
                        <Button Grid.Column="2"
                                Name="AcceptButton"
                                MinWidth="130"
                                Background="#FFFFC09F"
                                Foreground="#FF1F1A24">
                            <TextBlock Name="AcceptButtonText" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
