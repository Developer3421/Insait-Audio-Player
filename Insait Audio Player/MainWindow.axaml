<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Insait_Audio_Player.Models"
        mc:Ignorable="d"
        x:CompileBindings="False"
        d:DesignWidth="720"
        d:DesignHeight="500"
        x:Class="Insait_Audio_Player.MainWindow"
        Title="Insait Audio Player"
        Icon="avares://Insait Audio Player/Modern_futuristic_audio_player (2).ico"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Width="720"
        Height="500"
        MinWidth="600"
        MinHeight="420"
        CanResize="False"
        Background="Transparent"
        FontFamily="Segoe UI, Arial, Tahoma">

    <Window.Resources>
        <Color x:Key="AppBgColor">#FF1F1A24</Color>
        <Color x:Key="AppSurfaceColor">#FF2A2230</Color>
        <Color x:Key="AppBorderColor">#FF3E3050</Color>
        <Color x:Key="AppTextColor">#FFF0E8F4</Color>
        <Color x:Key="AppTextMutedColor">#FF9E90B0</Color>
        <Color x:Key="AccentOrangeColor">#FFFFC09F</Color>
        <Color x:Key="AccentOrangeHoverColor">#FFFFD4B8</Color>
        <Color x:Key="AccentPurpleColor">#FFDCC4FF</Color>
        <Color x:Key="AccentGreenColor">#FFA6E3A1</Color>
        <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}"/>
        <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}"/>
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}"/>
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}"/>
        <SolidColorBrush x:Key="AccentOrangeHoverBrush" Color="{StaticResource AccentOrangeHoverColor}"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#FF2D2438"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#20FFDAB0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#CCE53935"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.ctrl-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ctrl-btn:pointerover">
            <Setter Property="Background" Value="#20FFDAB0"/>
        </Style>
        <Style Selector="Button.ctrl-btn:pressed">
            <Setter Property="Background" Value="#40FFDAB0"/>
        </Style>

        <Style Selector="Button.play-btn">
            <Setter Property="Background" Value="{StaticResource AccentOrangeBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.play-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentOrangeHoverBrush}"/>
        </Style>

        <Style Selector="Button.toggle-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.toggle-btn:pointerover">
            <Setter Property="Background" Value="#20DCC4FF"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
        </Style>
        <Style Selector="Button.toggle-btn.active">
            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
        </Style>
        <Style Selector="Button.toggle-btn.active:pointerover">
            <Setter Property="Background" Value="#20FFC09F"/>
            <Setter Property="Foreground" Value="{StaticResource AccentOrangeHoverBrush}"/>
        </Style>

        <Style Selector="Button.secondary-action">
            <Setter Property="Background" Value="#18DCC4FF"/>
            <Setter Property="BorderBrush" Value="#55DCC4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondary-action:pointerover">
            <Setter Property="Background" Value="#28DCC4FF"/>
            <Setter Property="BorderBrush" Value="#88DCC4FF"/>
        </Style>
        <Style Selector="Button.secondary-action:pressed">
            <Setter Property="Background" Value="#34DCC4FF"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#12FFDAB0"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#28FFC09F"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource AppTextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource AppBgBrush}"
            BorderBrush="#FF7C3AED"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#CC3E1060"
                              BlurRadius="36"
                              OffsetX="0"
                              OffsetY="10"
                              Opacity="0.85"/>
        </Border.Effect>

        <Grid RowDefinitions="38,*">
            <Border Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    CornerRadius="12,12,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0"
                                Spacing="8">
                        <Image Source="avares://Insait Audio Player/Icons/Modern_futuristic_audio_player (2).png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               VerticalAlignment="Center"/>
                        <TextBlock Name="WindowTitleText"
                                   Text="Insait Audio Player"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="Transparent"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Name="LanguageButton" Classes="window-control" ToolTip.Tip="Change language">
                            <TextBlock Name="LanguageButtonText"
                                       Text="EN"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button Name="MinimizeButton" Classes="window-control" ToolTip.Tip="Згорнути">
                            <Image Source="avares://Insait Audio Player/Icons/MinButton.png"
                                   Width="30"
                                   Height="30"
                                   Stretch="Uniform"/>
                        </Button>
                        <Button Name="CloseButton" Classes="window-control close" ToolTip.Tip="Закрити">
                            <Image Source="avares://Insait Audio Player/Icons/CloseButton.png"
                                   Width="30"
                                   Height="30"
                                   Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="276,1,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <Border Grid.Row="0"
                            Margin="20,18,20,0"
                            Height="158"
                            CornerRadius="10"
                            ClipToBounds="True"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#FF3E1060" Offset="0"/>
                                <GradientStop Color="#FF241840" Offset="0.45"/>
                                <GradientStop Color="#FFFF6A10" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Name="CoverImage"
                                   IsVisible="False"
                                   Stretch="UniformToFill"/>
                            <Image Name="DefaultCoverIcon"
                                   Source="avares://Insait Audio Player/Icons/Modern_futuristic_audio_player (2).png"
                                   Width="96"
                                   Height="96"
                                   Opacity="0.95"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            <Border Background="#25FFC09F"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}"/>
                                    <TextBlock Text="WIN API"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentGreenBrush}"
                                               LetterSpacing="1"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#30000000"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0">
                                <TextBlock Text="MP3"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentPurpleBrush}"
                                           LetterSpacing="1"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="20,12,20,0" Spacing="3">
                        <TextBlock Name="TrackTitle"
                                   Text="Додайте MP3 файл"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Name="TrackArtist"
                                   Text="Відтворення через Windows MCI"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentPurpleBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Name="TrackAlbum"
                                   Text="Плейлист буде автоматично збережено у SQLite"
                                   Classes="muted"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="20,12,20,0" RowDefinitions="Auto,Auto">
                        <Slider Grid.Row="0"
                                Name="SeekSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,-2"/>
                        <Grid Grid.Row="1" ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0"
                                       Name="CurrentTime"
                                       Text="0:00"
                                       Classes="muted"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1"
                                       Name="TotalTime"
                                       Text="0:00"
                                       Classes="muted"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0"
                                Spacing="6">
                        <Button Classes="ctrl-btn" Name="SeekBackwardButton" ToolTip.Tip="Перемотати на 10 секунд назад">
                            <TextBlock Text="⏪"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="18"
                                       Foreground="{StaticResource AppTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ctrl-btn" Name="PrevButton" ToolTip.Tip="Попередній трек">
                            <TextBlock Text="⏮"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="20"
                                       Foreground="{StaticResource AppTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="play-btn" Name="PlayButton" ToolTip.Tip="Відтворити / Пауза">
                            <TextBlock Name="PlayIcon"
                                       Text="▶"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="22"
                                       Foreground="#FF1F1A24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ctrl-btn" Name="NextButton" ToolTip.Tip="Наступний трек">
                            <TextBlock Text="⏭"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="20"
                                       Foreground="{StaticResource AppTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ctrl-btn" Name="SeekForwardButton" ToolTip.Tip="Перемотати на 10 секунд вперед">
                            <TextBlock Text="⏩"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="18"
                                       Foreground="{StaticResource AppTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="20,10,20,14" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <Button Grid.Column="0" Classes="toggle-btn" Name="ShuffleButton" ToolTip.Tip="Перемішати">
                            <TextBlock Text="🔀" FontFamily="Segoe UI Emoji" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="1" Classes="toggle-btn active" Name="RepeatButton" ToolTip.Tip="Повторювати">
                            <TextBlock Text="🔁" FontFamily="Segoe UI Emoji" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="2"
                                Classes="toggle-btn"
                                Name="PlaybackRateButton"
                                ToolTip.Tip="Змінити швидкість відтворення"
                                Width="50">
                            <TextBlock Name="SpeedText"
                                       Text="1.0x"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <TextBlock Grid.Column="3"
                                   Text="🔊"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="6,0,2,0"
                                   Opacity="0.65"/>
                        <Slider Grid.Column="4"
                                Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="75"
                                VerticalAlignment="Center"/>
                        <Button Grid.Column="5"
                                Classes="toggle-btn"
                                Name="OpenButton"
                                ToolTip.Tip="Відкрити MP3 файл"
                                Margin="4,0,0,0">
                            <TextBlock Text="📂" FontFamily="Segoe UI Emoji" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="6"
                                Classes="secondary-action"
                                Name="SetDefaultMp3Button"
                                ToolTip.Tip="Зробити плеєр типовим для .mp3"
                                Margin="8,0,0,0">
                            <TextBlock Name="SetDefaultMp3ButtonText"
                                       Text="Для MP3"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource AppBorderBrush}" Margin="0,10,0,10"/>

                <Grid Grid.Column="2" RowDefinitions="Auto,1,*,Auto">
                    <Grid Grid.Row="0" Margin="14,14,14,10" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <Image Grid.Column="0"
                               Source="avares://Insait Audio Player/Icons/Modern_futuristic_audio_player (2).png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Name="PlaylistHeaderText"
                                   Text="Плейлист"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="2"
                                Background="#30FFC09F"
                                CornerRadius="10"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="8,0,0,0">
                            <TextBlock Name="PlaylistCountText" Text="0" Classes="section-title" FontSize="11"/>
                        </Border>
                        <Button Grid.Column="3" Name="EncryptedInfoButton" Classes="toggle-btn" ToolTip.Tip="Плейлист шифрується в SQLite">
                            <TextBlock Text="🔐" FontFamily="Segoe UI Emoji" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="4" Classes="toggle-btn active" Name="AddFilesButton" ToolTip.Tip="Додати MP3 файли">
                            <TextBlock Text="➕" FontFamily="Segoe UI Emoji" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource AppBorderBrush}" Margin="14,0,14,0"/>

                    <ListBox Grid.Row="2"
                             Name="PlaylistBox"
                             Margin="0,4,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="6"
                                            Background="{Binding BadgeBackground}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding LeadingText}"
                                                   FontSize="11"
                                                   Foreground="{Binding BadgeForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DurationText}"
                                                                       Classes="muted"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Name="PlaylistSummaryText"
                                       Text="0 треків  •  0:00 загалом"
                                       Classes="muted"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Classes="toggle-btn"
                                    Name="SavePlaylistButton"
                                    ToolTip.Tip="Зберегти плейлист зараз">
                                <TextBlock Text="💾" FontFamily="Segoe UI Emoji" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="toggle-btn"
                                    Name="ClearButton"
                                    ToolTip.Tip="Очистити плейлист">
                                <TextBlock Text="🗑️" FontFamily="Segoe UI Emoji" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
